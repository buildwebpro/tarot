rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // บทความ - อ่านได้ทุกคน, เขียนได้เฉพาะ admin
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // โปรไฟล์ผู้ใช้ - อ่านได้เฉพาะเจ้าของ, เขียนได้เจ้าของหรือ admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ประวัติการทำนาย (Readings/History)
    // - อ่านได้เฉพาะเจ้าของหรือ admin (แก้ปัญหา: ทุกคนที่ล็อกอินอ่านได้หมด)
    // - สร้างได้เฉพาะเมื่อ userId ในเอกสารตรงกับผู้ที่ล็อกอิน
    // - แก้ไข/ลบได้เฉพาะเจ้าของหรือ admin
    match /history/{readingId} {
      allow read: if request.auth != null && (isOwner(resource.data.userId) || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && (isOwner(resource.data.userId) || isAdmin());
    }

    // ลบกฎ catch-all อันตรายที่อนุญาตให้อ่านทุกอย่าง
    // หากต้องการอนุญาตเพิ่มในอนาคต ให้ประกาศ collection ให้ชัดเจน
    // match /{document=**} { allow read: if false; }
  }
}