rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // บทความ - อ่านได้ทุกคน, เขียนได้เฉพาะ admin
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // โปรไฟล์ผู้ใช้ - อ่านได้เฉพาะเจ้าของ, เขียนได้เจ้าของหรือ admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ประวัติการทำนาย - อ่านได้ทุกคนที่ล็อกอิน, เขียนได้เฉพาะเจ้าของ
    match /history/{readingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // อนุญาตให้อ่านได้ทั้งหมด
    match /{document=**} {
      allow read: if true;
    }
  }
}